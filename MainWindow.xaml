<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ludoteca.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ludoteca"
    Title="Ludoteca">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <CollectionViewSource x:Name="DriveGroups" IsSourceGrouped="True" />

            <!-- Il gioco arriva dal Tag dell'elemento su cui si apre il menu (vedi GameMenu_Opening). -->
            <MenuFlyout x:Key="GameMenu" Opening="GameMenu_Opening">
                <MenuFlyoutItem Text="Apri cartella" Click="OpenFolder_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copia percorso" Click="CopyPath_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Disinstalla" Click="Uninstall_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <!-- Riga della lista: copertina piccola, nome, launcher/ultima partita/cartella, dimensione, azioni -->
            <DataTemplate x:Key="GameTemplate" x:DataType="local:GameEntry">
                <Grid Padding="4,8" ColumnSpacing="14" ContextFlyout="{StaticResource GameMenu}" Tag="{x:Bind}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="54" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind local:Ui.VisibleIf(Icon), Mode=OneWay}">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Margin="6" />
                            </Border>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind LastPlayedTooltip}">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Apri cartella" Tag="{x:Bind}"
                                AutomationProperties.Name="Apri cartella"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                        </Button>
                        <Button Click="Uninstall_Click" ToolTipService.ToolTip="Disinstalla" Padding="10,6" Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind UninstallLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Disinstalla" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Scheda della griglia "Da disinstallare" -->
            <DataTemplate x:Key="RecTemplate" x:DataType="local:GameEntry">
                <Grid Padding="10" ColumnSpacing="12" CornerRadius="8" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      ContextFlyout="{StaticResource GameMenu}" Tag="{x:Bind}"
                      ToolTipService.ToolTip="{x:Bind LastPlayedTooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="84" Height="112" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind local:Ui.VisibleIf(Icon), Mode=OneWay}">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Margin="14" />
                            </Border>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{x:Bind RecommendReason}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FreeableText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="3" Click="Uninstall_Click" Padding="10,4" Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind UninstallLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="Disinstalla" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra del titolo personalizzata -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7FC;" FontSize="16" />
            <TextBlock Grid.Column="1" Text="Ludoteca" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneDisplayMode="Left" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Cerca un gioco" QueryIcon="Find"
                                TextChanged="Search_TextChanged" />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tutti i giochi" Tag="all" Icon="AllApps" />
                <NavigationViewItem Content="Per disco" Tag="drives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="32,16,32,0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Tutti i giochi" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressRing x:Name="Busy" Grid.Column="1" Width="24" Height="24" IsActive="False" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Aggiorna" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Informational"
                             Title="È disponibile una nuova versione">
                        <InfoBar.ActionButton>
                            <Button x:Name="UpdateButton" Content="Aggiorna e riavvia" Click="Update_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                        <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100" Margin="0,0,0,12" />
                    </InfoBar>
                    <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />
                </StackPanel>

                <ListView x:Name="AllList" Grid.Row="2" SelectionMode="None"
                          ItemTemplate="{StaticResource GameTemplate}" Padding="0,0,0,24">
                    <ListView.Header>
                        <!-- Griglia "Da disinstallare": 3x3 se c'è spazio, altrimenti 2x2 -->
                        <StackPanel x:Name="RecPanel" Spacing="10" Margin="0,4,0,20" Visibility="Collapsed"
                                    SizeChanged="RecPanel_SizeChanged">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="Da disinstallare" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="RecSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="RecRepeater" ItemTemplate="{StaticResource RecTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout x:Name="RecLayout" ItemsStretch="Fill" MaximumRowsOrColumns="3"
                                                       MinItemWidth="220" MinItemHeight="134"
                                                       MinColumnSpacing="12" MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock Text="Tutti i giochi" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        </StackPanel>
                    </ListView.Header>
                </ListView>

                <ListView x:Name="DriveList" Grid.Row="2" SelectionMode="None" Visibility="Collapsed"
                          ItemTemplate="{StaticResource GameTemplate}" Padding="0,0,0,24">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:DriveGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,4">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="18" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Header}" Style="{StaticResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Details, Mode=OneWay}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Impostazioni -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left" Padding="0,0,0,24">
                        <TextBlock Text="Copertine" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            Le copertine arrivano da Steam (anche per i giochi di altri launcher venduti su Steam)
                            e dal Microsoft Store per i giochi Xbox, senza configurare niente. Se un gioco non è in
                            nessuno dei due negozi si usa la sua icona. Per avere più copertine puoi aggiungere
                            SteamGridDB: accedi con Steam, apri le preferenze del profilo, genera una chiave API e
                            incollala qui. Le copertine scaricate restano sul PC.
                        </TextBlock>
                        <HyperlinkButton Content="Apri la pagina della chiave API di SteamGridDB"
                                         NavigateUri="https://www.steamgriddb.com/profile/preferences/api" Padding="0" />
                        <PasswordBox x:Name="SecretBox" Header="Chiave API di SteamGridDB" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            La chiave viene salvata cifrata con il tuo account Windows.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveSettingsButton" Content="Salva e cerca le copertine"
                                    Style="{StaticResource AccentButtonStyle}" Click="SaveSettings_Click" />
                            <Button Content="Svuota cache copertine" Click="ClearCovers_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" />

                        <TextBlock Text="Aggiornamenti" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
                        <TextBlock x:Name="VersionText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Content="Controlla aggiornamenti" Click="CheckUpdates_Click" />
                            <HyperlinkButton Content="Note di rilascio" NavigateUri="https://github.com/rawnly/ludoteca/releases" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
