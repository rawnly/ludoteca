<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ludoteca.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ludoteca"
    Title="Ludoteca">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <CollectionViewSource x:Name="DriveGroups" IsSourceGrouped="True" />

            <!-- Il gioco arriva dal Tag dell'elemento su cui si apre il menu (vedi GameMenu_Opening). -->
            <MenuFlyout x:Key="GameMenu" Opening="GameMenu_Opening">
                <MenuFlyoutItem Text="Gioca" Click="Play_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Apri cartella" Click="OpenFolder_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copia percorso" Click="CopyPath_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Disinstalla" Click="Uninstall_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <!-- Riga della lista: copertina piccola, nome, launcher/ultima partita/cartella, dimensione, azioni -->
            <DataTemplate x:Key="GameTemplate" x:DataType="local:GameEntry">
                <Grid Padding="4,8" ColumnSpacing="14" ContextFlyout="{StaticResource GameMenu}" Tag="{x:Bind}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="54" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind local:Ui.VisibleIf(Icon), Mode=OneWay}">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Margin="6" />
                            </Border>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind LastPlayedTooltip}">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Apri cartella" Tag="{x:Bind}"
                                AutomationProperties.Name="Apri cartella"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                        </Button>
                        <Button Click="Uninstall_Click" ToolTipService.ToolTip="Disinstalla" Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind UninstallLabel}"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                        <Button Click="Play_Click" ToolTipService.ToolTip="Gioca" Padding="14,6" Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind PlayLabel}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Gioca" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Scheda della griglia "Da disinstallare" -->
            <DataTemplate x:Key="RecTemplate" x:DataType="local:GameEntry">
                <Grid Padding="10" ColumnSpacing="12" CornerRadius="8" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      ContextFlyout="{StaticResource GameMenu}" Tag="{x:Bind}"
                      ToolTipService.ToolTip="{x:Bind LastPlayedTooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="84" Height="112" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind local:Ui.VisibleIf(Icon), Mode=OneWay}">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Margin="14" />
                            </Border>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{x:Bind RecommendReason}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FreeableText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="3" Click="Uninstall_Click" Padding="10,4" Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind UninstallLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="Disinstalla" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- Copertina della modalità TV -->
            <DataTemplate x:Key="TvCoverTemplate" x:DataType="local:GameEntry">
                <StackPanel Spacing="10" Width="200">
                    <Border Width="200" Height="300" CornerRadius="8" Background="#22FFFFFF">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="48" Foreground="#99FFFFFF" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" Margin="36" />
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Name}" Foreground="#CCFFFFFF" FontSize="15"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.KeyboardAcceleratorPlacementMode>Hidden</Grid.KeyboardAcceleratorPlacementMode>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="ToggleTv_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra del titolo personalizzata -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7FC;" FontSize="16" />
            <TextBlock Grid.Column="1" Text="Ludoteca" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneDisplayMode="Left" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Cerca un gioco" QueryIcon="Find"
                                TextChanged="Search_TextChanged" />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tutti i giochi" Tag="all" Icon="AllApps" />
                <NavigationViewItem Content="Per disco" Tag="drives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="32,16,32,0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TvButton" Grid.Column="3" Click="EnterTv_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Modalità TV"
                            ToolTipService.ToolTip="Schermo intero, navigabile con il controller (F11 o Start)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            <TextBlock Text="Modalità TV" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Tutti i giochi" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressRing x:Name="Busy" Grid.Column="1" Width="24" Height="24" IsActive="False" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Aggiorna" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Informational"
                             Title="È disponibile una nuova versione">
                        <InfoBar.ActionButton>
                            <Button x:Name="UpdateButton" Content="Aggiorna e riavvia" Click="Update_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                        <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100" Margin="0,0,0,12" />
                    </InfoBar>
                    <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />
                </StackPanel>

                <ListView x:Name="AllList" Grid.Row="2" SelectionMode="None"
                          ItemTemplate="{StaticResource GameTemplate}" Padding="0,0,0,24">
                    <ListView.Header>
                        <!-- Griglia "Da disinstallare": 3x3 se c'è spazio, altrimenti 2x2 -->
                        <StackPanel x:Name="RecPanel" Spacing="10" Margin="0,4,0,20" Visibility="Collapsed"
                                    SizeChanged="RecPanel_SizeChanged">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="Da disinstallare" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="RecSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="RecRepeater" ItemTemplate="{StaticResource RecTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout x:Name="RecLayout" ItemsStretch="Fill" MaximumRowsOrColumns="3"
                                                       MinItemWidth="220" MinItemHeight="134"
                                                       MinColumnSpacing="12" MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock Text="Tutti i giochi" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        </StackPanel>
                    </ListView.Header>
                </ListView>

                <ListView x:Name="DriveList" Grid.Row="2" SelectionMode="None" Visibility="Collapsed"
                          ItemTemplate="{StaticResource GameTemplate}" Padding="0,0,0,24">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:DriveGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,4">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="18" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Header}" Style="{StaticResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Details, Mode=OneWay}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Impostazioni -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left" Padding="0,0,0,24">
                        <TextBlock Text="Copertine" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            Le copertine arrivano da Steam (anche per i giochi di altri launcher venduti su Steam)
                            e dal Microsoft Store per i giochi Xbox, senza configurare niente. Se un gioco non è in
                            nessuno dei due negozi si usa la sua icona. Per avere più copertine puoi aggiungere
                            SteamGridDB: accedi con Steam, apri le preferenze del profilo, genera una chiave API e
                            incollala qui. Le copertine scaricate restano sul PC.
                        </TextBlock>
                        <HyperlinkButton Content="Apri la pagina della chiave API di SteamGridDB"
                                         NavigateUri="https://www.steamgriddb.com/profile/preferences/api" Padding="0" />
                        <PasswordBox x:Name="SecretBox" Header="Chiave API di SteamGridDB" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            La chiave viene salvata cifrata con il tuo account Windows.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveSettingsButton" Content="Salva e cerca le copertine"
                                    Style="{StaticResource AccentButtonStyle}" Click="SaveSettings_Click" />
                            <Button Content="Svuota cache copertine" Click="ClearCovers_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" />

                        <TextBlock Text="Aggiornamenti" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
                        <TextBlock x:Name="VersionText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Content="Controlla aggiornamenti" Click="CheckUpdates_Click" />
                            <HyperlinkButton Content="Note di rilascio" NavigateUri="https://github.com/rawnly/ludoteca/releases" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- ======================= Modalità TV: schermo intero, tastiera e controller ======================= -->
        <Grid x:Name="TvView" Grid.RowSpan="2" Visibility="Collapsed" Background="#FF0B0E14"
              RequestedTheme="Dark" KeyDown="TvView_KeyDown">
            <Image x:Name="TvHero" Stretch="UniformToFill" Opacity="0.6">
                <Image.OpacityTransition><ScalarTransition Duration="0:0:0.3" /></Image.OpacityTransition>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#990B0E14" Offset="0" />
                        <GradientStop Color="#590B0E14" Offset="0.25" />
                        <GradientStop Color="#D90B0E14" Offset="0.5" />
                        <GradientStop Color="#F20B0E14" Offset="0.65" />
                        <GradientStop Color="#FF0B0E14" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Padding="72,40,72,32" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- In alto: nome dell'app e ora -->
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" FontSize="22" />
                        <TextBlock Text="Ludoteca" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="TvClock" FontSize="22" HorizontalAlignment="Right" />
                </Grid>

                <!-- Gioco selezionato -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock x:Name="TvTitle" FontSize="52" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TvDetails" FontSize="20" Foreground="#CCFFFFFF" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button x:Name="TvPlayButton" Click="TvPlay_Click" Style="{StaticResource AccentButtonStyle}"
                                Padding="28,12" XYFocusDown="{x:Bind TvList}" AutomationProperties.Name="Gioca">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE768;" FontSize="20" />
                                <TextBlock Text="Gioca" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TvOptionsButton" Click="TvOptions_Click" Padding="20,12" XYFocusDown="{x:Bind TvList}"
                                AutomationProperties.Name="Opzioni">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE712;" FontSize="20" />
                                <TextBlock Text="Opzioni" FontSize="20" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Fila di copertine -->
                <ListView x:Name="TvList" Grid.Row="2" Height="360" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="TvList_ItemClick"
                          SelectionChanged="TvList_SelectionChanged"
                          ItemTemplate="{StaticResource TvCoverTemplate}"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.IsHorizontalRailEnabled="True" Padding="0,24,0,0">
                    <ListView.Resources>
                        <!-- Niente riquadro di selezione: la copertina selezionata si riconosce perché è più grande. -->
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,20,0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Suggerimenti dei comandi -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="32" HorizontalAlignment="Right">
                    <TextBlock x:Name="TvHintPlay" Text="Ⓐ  Gioca" FontSize="16" Foreground="#CCFFFFFF" />
                    <TextBlock x:Name="TvHintOptions" Text="Ⓨ  Opzioni" FontSize="16" Foreground="#CCFFFFFF" />
                    <TextBlock x:Name="TvHintExit" Text="⧉  Esci dalla modalità TV" FontSize="16" Foreground="#CCFFFFFF" />
                </StackPanel>
            </Grid>

            <!-- Avvio in corso -->
            <Grid x:Name="TvLaunching" Visibility="Collapsed" Background="#D90B0E14">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                    <ProgressRing IsActive="True" Width="56" Height="56" />
                    <TextBlock x:Name="TvLaunchingText" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TvLaunchingSource" FontSize="18" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
